model User {
  id            Int      @id @default(autoincrement())
  email         String
  password      String
  role          RoleType @default(STUDENT)
  is_superadmin Boolean  @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  posts Post[]
}

enum RoleType {
  ADMIN
  MODERATOR
  TEACHER
  STUDENT_PLUS
  STUDENT
}
