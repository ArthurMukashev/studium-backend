// Пользователь
model User {
  id            Int     @id @default(autoincrement())
  email         String
  password      String
  is_superadmin Boolean @default(false)

  name      String?
  surname   String?
  patroname String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  employers Employer[]
  posts     Post[]
}

// Сотрудник
model Employer {
  id            Int @id @default(autoincrement())
  user_id       Int
  university_id Int
  role_id       Int

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  role       Role       @relation(fields: [role_id], references: [id])
  university University @relation(fields: [university_id], references: [id])
  user       User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Role {
  id   Int      @id @default(autoincrement())
  name RoleType @unique

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  employers Employer[]
}

enum RoleType {
  // Администратор
  ADMIN

  // Модератор (декан, зам декана)
  MODERATOR

  // Преподаватель
  TEACHER

  // Староста
  STUDENT_PLUS

  // Студент
  STUDENT

  // Персонал
  STAFF
}
