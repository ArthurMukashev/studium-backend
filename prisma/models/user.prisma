// Пользователь
model User {
  id            Int     @id @default(autoincrement())
  role_id       Int
  email         String
  password      String
  is_superadmin Boolean @default(false)

  name      String?
  surname   String?
  patroname String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  role Role @relation(fields: [role_id], references: [id])
}

model Role {
  id   Int      @id @default(autoincrement())
  name RoleType @unique

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  users User[]
}

enum RoleType {
  // Администратор
  ADMIN

  // Модератор
  MODERATOR

  // Пользователь
  USER
}
